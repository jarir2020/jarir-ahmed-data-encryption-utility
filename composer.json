{
    "name": "jarir-ahmed/data-encryption-utility",
    "description": "Authenticated symmetric encryption for PHP (AES-256-GCM by default, encrypt-then-HMAC fallback).",
    "type": "library",
    "license": "MIT",
    "keywords": ["encryption", "aes", "gcm", "crypto", "openssl"],
    "authors": [
        {
            "name": "Jarir Ahmed",
            "email": "jarircse16@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "JarirAhmed\\Encryptor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JarirAhmed\\Encryptor\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.2",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
